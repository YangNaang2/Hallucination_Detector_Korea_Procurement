              "required": [
                "master_pointer",
                "evidence_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "document_version",
          "tenant_id",
          "security_level",
          "allowed_roles",
          "text",
          "text_start",
          "text_end",
          "offset_unit",
          "source_fact_refs"
