            ]
          },
          "allowed_roles": {
            "type": "array",
            "items": {
              "enum": [
                "bid_analyst",
                "cost_analyst",
                "bid_approver"
              ]
            },
            "minItems": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "text_start": {
            "type": "integer",
            "minimum": 0
          },
          "text_end": {
            "type": "integer",
            "minimum": 0
          },
